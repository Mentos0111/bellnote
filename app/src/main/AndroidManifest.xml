<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NtfyCalendar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NtfyCalendar.Home">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.EditActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ImportActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NtfyCalendar.Home" />

        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.HealthActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />


        <activity-alias
            android:name=".ui.IconTeal"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_teal"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_teal"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.IconIndigo"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_indigo"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_indigo"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.IconSand"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_sand"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_sand"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.IconInk"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_ink"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_ink"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.IconPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_pink"
            android:label="Bellnote"
            android:roundIcon="@drawable/ic_launcher_pink"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.IconSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_sakura"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_sakura"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.ThirdPartyActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.NtfyActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.ThirdPartyActivity" />

        <activity
            android:name=".ui.MessageLogActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.NtfyActivity" />

        <activity
            android:name=".ui.ReconcileActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AllEventsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 系统侧边栏（智能侧边栏）里添加的那个入口：点一下截当前屏幕并去识别。
             桌面图标不再是 Activity 自带，而是下面这个 activity-alias，默认 disabled：
             需要在系统侧边栏里添加时，去「设置 → 侧边栏入口」一键打开，加完再关掉。 -->
        <activity
            android:name=".ui.SidebarCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/sidebar_app_label"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.Bellnote.Transparent" />

        <activity-alias
            android:name=".ui.SidebarEntry"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/sidebar_app_label"
            android:targetActivity=".ui.SidebarCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 分享一段文字 / 选中文字 → 记一条 -->
        <activity
            android:name=".ui.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Bellnote.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 截屏能力（无障碍服务）：只用来截当前屏幕 -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- 通知栏磁贴：点一下回首页并聚焦「一句话记」 -->
        <service
            android:name=".service.NtfyPollJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".service.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="记一条"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 内部传图用（截屏识别） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".service.ReconcileReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
