<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NtfyCalendar" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">?attr/bnPrimaryDark</item>
        <item name="colorPrimaryDark">?attr/bnPrimaryDark</item>
        <item name="colorAccent">?attr/bnAccent</item>
        <item name="android:windowBackground">?attr/bnWindowBg</item>
        <item name="android:statusBarColor">?attr/bnPrimaryDark</item>
        <item name="android:navigationBarColor">?attr/bnWindowBg</item>
        <!-- Android 12+ 的系统开屏：和我们的开屏同一个底色，图标底也做成底色，避免白色方块 -->
        <item name="android:windowSplashScreenBackground">?attr/bnWindowBg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <item name="android:windowAnimationStyle">@style/BellnoteWindowAnim</item>
        <item name="bnPrimary">@color/primary</item>
        <item name="bnPrimaryDark">@color/primary_dark</item>
        <item name="bnOnPrimary">@color/text_on_primary</item>
        <item name="bnAccent">@color/accent</item>
        <item name="bnWindowBg">@color/window_bg</item>
        <item name="bnSurface">@color/surface</item>
        <item name="bnCard">@color/card_bg</item>
        <item name="bnCardStroke">@color/card_stroke</item>
        <item name="bnCardEdge">@color/card_stroke</item>
        <item name="bnDivider">@color/divider</item>
        <item name="bnTextPrimary">@color/text_primary</item>
        <item name="bnTextSecondary">@color/text_secondary</item>
        <item name="bnChipBg">@color/chip_bg</item>
        <item name="bnIconBg">@color/icon_bg</item>
        <item name="bnDanger">@color/danger</item>
        <item name="bnOk">@color/ok</item>
        <item name="bnWarn">@color/warn</item>
        <item name="bnMuted">@color/muted</item>
        <item name="bnNavBg">@color/nav_bg</item>
        <item name="bnRipple">@color/ripple</item>
    </style>

    <!-- 页面切换：轻微上浮 + 淡入；返回时缩放淡出，比系统默认轻 -->
    <style name="BellnoteWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <!-- 首页自带顶栏（☰ + 标题），不要再叠一层系统 ActionBar -->
    <style name="Theme.NtfyCalendar.Home" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/bnPrimary</item>
        <item name="colorPrimaryDark">?attr/bnPrimaryDark</item>
        <item name="colorAccent">?attr/bnAccent</item>
        <item name="android:windowBackground">?attr/bnWindowBg</item>
        <item name="android:statusBarColor">?attr/bnPrimaryDark</item>
        <item name="android:navigationBarColor">?attr/bnWindowBg</item>
        <!-- Android 12+ 的系统开屏：和我们的开屏同一个底色，图标底也做成底色，避免白色方块 -->
        <item name="android:windowSplashScreenBackground">?attr/bnWindowBg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <item name="android:windowAnimationStyle">@style/BellnoteWindowAnim</item>
        <item name="bnPrimary">@color/primary</item>
        <item name="bnPrimaryDark">@color/primary_dark</item>
        <item name="bnOnPrimary">@color/text_on_primary</item>
        <item name="bnAccent">@color/accent</item>
        <item name="bnWindowBg">@color/window_bg</item>
        <item name="bnSurface">@color/surface</item>
        <item name="bnCard">@color/card_bg</item>
        <item name="bnCardStroke">@color/card_stroke</item>
        <item name="bnCardEdge">@color/card_stroke</item>
        <item name="bnDivider">@color/divider</item>
        <item name="bnTextPrimary">@color/text_primary</item>
        <item name="bnTextSecondary">@color/text_secondary</item>
        <item name="bnChipBg">@color/chip_bg</item>
        <item name="bnIconBg">@color/icon_bg</item>
        <item name="bnDanger">@color/danger</item>
        <item name="bnOk">@color/ok</item>
        <item name="bnWarn">@color/warn</item>
        <item name="bnMuted">@color/muted</item>
        <item name="bnNavBg">@color/nav_bg</item>
        <item name="bnRipple">@color/ripple</item>
    </style>

    <!-- 透明、无标题：侧边栏截屏入口和「分享文字」入口都靠它不挡内容 -->
    <style name="Theme.Bellnote.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="bnPrimary">@color/primary</item>
        <item name="bnPrimaryDark">@color/primary_dark</item>
        <item name="bnOnPrimary">@color/text_on_primary</item>
        <item name="bnAccent">@color/accent</item>
        <item name="bnWindowBg">@color/window_bg</item>
        <item name="bnSurface">@color/surface</item>
        <item name="bnCard">@color/card_bg</item>
        <item name="bnCardStroke">@color/card_stroke</item>
        <item name="bnCardEdge">@color/card_stroke</item>
        <item name="bnDivider">@color/divider</item>
        <item name="bnTextPrimary">@color/text_primary</item>
        <item name="bnTextSecondary">@color/text_secondary</item>
        <item name="bnChipBg">@color/chip_bg</item>
        <item name="bnIconBg">@color/icon_bg</item>
        <item name="bnDanger">@color/danger</item>
        <item name="bnOk">@color/ok</item>
        <item name="bnWarn">@color/warn</item>
        <item name="bnMuted">@color/muted</item>
        <item name="bnNavBg">@color/nav_bg</item>
        <item name="bnRipple">@color/ripple</item>
    </style>

    <!-- 文字 -->

    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>

    <!-- 设置页的分级：分组标题是可以点的，点一下展开 / 收起 -->
    <style name="SettingsGroupHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="SettingsSubHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">14dp</item>
    </style>

    <style name="SettingsHelpButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_icon_circle</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="SectionSubLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bnTextPrimary</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>

    <style name="FieldCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>

    <style name="HintText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>

    <!-- 输入 -->

    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/bnTextPrimary</item>
        <item name="android:textColorHint">?attr/bnTextSecondary</item>
    </style>

    <!-- 按钮 -->

    <style name="BtnPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">?attr/bnOnPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnTonal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">?attr/bnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnDanger">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">?attr/bnDanger</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 抽屉条目 -->

    <style name="NavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/bnTextPrimary</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AboutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="AboutKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/bnTextPrimary</item>
    </style>

    <style name="AboutValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>

    <style name="AboutDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/bnDivider</item>
    </style>

    <style name="NavRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_icon</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">?attr/bnTextSecondary</item>
    </style>

    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/bnTextPrimary</item>
    </style>

    <style name="NavSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/bnTextSecondary</item>
    </style>
</resources>
