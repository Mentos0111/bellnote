<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/FormLabel"
            android:layout_marginTop="8dp"
            android:text="@string/label_title" />

        <EditText
            android:id="@+id/etTitle"
            style="@style/FormInput"
            android:hint="数学作业"
            android:inputType="text" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_time" />

        <!-- 时间：一块「卡片」，点左边选日期、点右边选时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDate"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_pick_date" />

                <Button
                    android:id="@+id/btnTime"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_pick_time" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_duration" />

        <EditText
            android:id="@+id/etDuration"
            style="@style/FormInput"
            android:inputType="number"
            android:text="60" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_repeat" />

        <Spinner
            android:id="@+id/spRepeat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_note" />

        <EditText
            android:id="@+id/etNote"
            style="@style/FormInput"
            android:gravity="top"
            android:hint="第三章习题"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnSave"
            style="@style/BtnPrimary"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/BtnDanger"
            android:layout_marginTop="10dp"
            android:text="@string/btn_delete"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
