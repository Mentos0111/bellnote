<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvIntro"
            style="@style/HintText"
            android:layout_marginTop="6dp" />

        <!-- 生成 -->
        <LinearLayout
            android:id="@+id/groupGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textColor="?attr/bnTextPrimary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCopyCode"
                style="@style/BtnPrimary"
                android:layout_marginTop="14dp"
                android:text="复制配置码" />

            <Button
                android:id="@+id/btnShareCode"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="发给朋友" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="10dp"
                android:text="这串码里只有配色主题和 ntfy 主题，不含 API Key；朋友导入后还要自己填 Key。"
                android:visibility="visible" />
        </LinearLayout>

        <!-- 导入 -->
        <LinearLayout
            android:id="@+id/groupImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etCode"
                style="@style/FormInput"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="粘贴朋友发来的配置码（BN1. 开头）"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="110dp" />

            <TextView
                android:id="@+id/tvPreview"
                style="@style/HintText"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnImport"
                style="@style/BtnPrimary"
                android:layout_marginTop="14dp"
                android:enabled="false"
                android:text="导入这些设置" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
