<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="realme UI 6.0 需要手动打开四项开关，否则收不到 ntfy 通知或无法写日历。"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="1. 通知使用权\n设置 → 应用 → 特殊应用权限 → 通知使用权 → 允许「ntfy 待办日历」"
            android:textSize="14sp" />

        <Button
            style="@style/BtnTonal"
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="2. 日历权限\n首次保存时弹出，选「始终允许」"
            android:textSize="14sp" />

        <Button
            style="@style/BtnTonal"
            android:id="@+id/btnCalendarPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="3. 自启动\n设置 → 应用 → 自启动管理 → 允许「ntfy 待办日历」"
            android:textSize="14sp" />

        <Button
            style="@style/BtnTonal"
            android:id="@+id/btnAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="4. 电池白名单\n设置 → 电池 → 应用耗电管理 → 允许后台运行"
            android:textSize="14sp" />

        <Button
            style="@style/BtnTonal"
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_open" />

        <Button
            style="@style/BtnTonal"
            android:id="@+id/btnAppDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/perm_app_detail" />
    </LinearLayout>
</ScrollView>
