<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- 第 1 页：这是什么 -->
    <LinearLayout
        android:id="@+id/step1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_1_title"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/onboarding_1_body"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_quick" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onboarding_1_way1"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_screenshot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onboarding_1_way2"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_share" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onboarding_1_way3"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 页：必开的三个权限 -->
    <LinearLayout
        android:id="@+id/step2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_2_title"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:text="@string/onboarding_2_body"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="13sp" />

        <!-- 三项权限（状态 + 按钮，代码里填） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/permNotification"
                style="@style/AboutRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/AboutKey"
                    android:text="@string/onboarding_2_notification" />
                <TextView
                    android:id="@+id/permNotificationState"
                    style="@style/AboutValue" />
            </LinearLayout>

            <View style="@style/AboutDivider" />

            <LinearLayout
                android:id="@+id/permCalendar"
                style="@style/AboutRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/AboutKey"
                    android:text="@string/onboarding_2_calendar" />
                <TextView
                    android:id="@+id/permCalendarState"
                    style="@style/AboutValue" />
            </LinearLayout>

            <View style="@style/AboutDivider" />

            <LinearLayout
                android:id="@+id/permBattery"
                style="@style/AboutRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/AboutKey"
                    android:text="@string/onboarding_2_battery" />
                <TextView
                    android:id="@+id/permBatteryState"
                    style="@style/AboutValue" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/onboarding_2_hint"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 第 3 页：完成 -->
    <LinearLayout
        android:id="@+id/step3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_3_title"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/onboarding_3_body"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="@string/onboarding_3_tip1"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/onboarding_3_tip2"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：进度点 + 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_ok" />

            <View
                android:id="@+id/dot2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/dot_idle" />

            <View
                android:id="@+id/dot3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/dot_idle" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSkip"
            style="@style/BtnDanger"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/onboarding_skip"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNext"
            style="@style/BtnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="104dp"
            android:text="@string/onboarding_next"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
