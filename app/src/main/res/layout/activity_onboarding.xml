<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <!-- 顶部一层很淡的底色渐晕 -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:background="@drawable/bg_ambient" />

    <!-- 五页并排放在一个 deck 里，翻页整层平移 -->
    <com.bellnote.ui.SwipeDeck
        android:id="@+id/deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- 1 记法 -->
        <LinearLayout
            android:id="@+id/step1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="104dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_hero_ring" />

                <ImageView
                    android:id="@+id/hero1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_quick"
                    android:tint="?attr/bnPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记一条，只要一步"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="一句话、一张截图、一次分享，都能变成日历里的待办。"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2 权限：先出现图标与「如何实现」，再动画换成开关清单 -->
        <LinearLayout
            android:id="@+id/step2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="104dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_hero_ring" />

                <ImageView
                    android:id="@+id/hero2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scene_shield" />
            </FrameLayout>

            <TextView
                android:id="@+id/intro2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何实现"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="不开会漏推送，或被系统掐掉。点一行跳过去。"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <LinearLayout
                        android:id="@+id/permCalendar"
                        style="@style/AboutRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/AboutKey"
                            android:text="日历读写" />
                        <TextView
                            android:id="@+id/permCalendarState"
                            style="@style/AboutValue" />
                    </LinearLayout>

                    <View style="@style/AboutDivider" />

                    <LinearLayout
                        android:id="@+id/permBattery"
                        style="@style/AboutRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/AboutKey"
                            android:text="电池白名单" />
                        <TextView
                            android:id="@+id/permBatteryState"
                            style="@style/AboutValue" />
                    </LinearLayout>

                    <View style="@style/AboutDivider" />

                    <LinearLayout
                        android:id="@+id/permAutostart"
                        style="@style/AboutRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/AboutKey"
                            android:text="自启动" />
                        <TextView
                            android:id="@+id/permAutostartState"
                            style="@style/AboutValue" />
                    </LinearLayout>

                    <View style="@style/AboutDivider" />

                    <LinearLayout
                        android:id="@+id/permMedia"
                        style="@style/AboutRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/AboutKey"
                            android:text="读取相册（可选）" />
                        <TextView
                            android:id="@+id/permMediaState"
                            style="@style/AboutValue" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPermHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/bnDanger"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 配置 -->
        <LinearLayout
            android:id="@+id/step3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="104dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_hero_ring" />

                <ImageView
                    android:id="@+id/hero3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_screenshot"
                    android:tint="?attr/bnPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="截图识别（可选）"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="不配也能用一句话记；配了才能把截图里的字读成待办。"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="14sp" />

            <TextView
                style="@style/FormLabel"
                android:text="DeepSeek API Key" />

            <EditText
                android:id="@+id/etOnbApiKey"
                style="@style/FormInput"
                android:hint="sk-…"
                android:inputType="textPassword" />

            <TextView
                style="@style/FormLabel"
                android:text="视觉模型" />

            <EditText
                android:id="@+id/etOnbModel"
                style="@style/FormInput"
                android:inputType="text" />
        </LinearLayout>

        <!-- 4 日历 -->
        <LinearLayout
            android:id="@+id/step4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="104dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_hero_ring" />

                <ImageView
                    android:id="@+id/hero4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scene_calendar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="写进哪个日历"
                    android:textColor="?attr/bnTextPrimary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnHelpCalendar"
                    style="@style/SettingsHelpButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="选一次就行，之后随时能改。"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spOnbCalendar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <TextView
                android:id="@+id/tvOnbCalendarHint"
                style="@style/HintText"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5 结束 -->
        <LinearLayout
            android:id="@+id/step5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="104dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_hero_ring" />

                <ImageView
                    android:id="@+id/hero5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_check"
                    android:tint="?attr/bnPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可以开始用了"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="首页敲一句就能记，设置里都能改。"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

    </com.bellnote.ui.SwipeDeck>

    <!-- 底部：进度点 + 下一步 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/dotsBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="18dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_active" />
            <View
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_idle" />
            <View
                android:id="@+id/dot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_idle" />
            <View
                android:id="@+id/dot4"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_idle" />
            <View
                android:id="@+id/dot5"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_idle" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            style="@style/BtnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="下一步" />
    </LinearLayout>
</FrameLayout>
