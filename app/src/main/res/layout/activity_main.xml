<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <!-- 顶栏一行：☰ 在左，品牌名 + 版本号在右 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-8dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/bnTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersionTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 一句话记一条：输入 → 发送 → 截屏，三个并排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuick"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_hero"
                android:hint="@string/quick_hint"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="?attr/bnTextPrimary"
                android:textColorHint="?attr/bnTextSecondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnQuickGo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="@string/quick_go_desc"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />

            <ImageButton
                android:id="@+id/btnShotIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/btn_shot_big"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_screenshot" />
        </LinearLayout>

        <!-- 两颗指示灯：体检结果 + 配置状态，点了都进「运行体检」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/healthChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:drawableStart="@drawable/dot_ok"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="11dp"
                android:paddingTop="6dp"
                android:paddingRight="9dp"
                android:paddingBottom="6dp"
                android:text="检测中"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:drawableStart="@drawable/dot_ok"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="11dp"
                android:paddingTop="6dp"
                android:paddingRight="9dp"
                android:paddingBottom="6dp"
                android:text="一切就绪"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/main_empty"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- 侧边抽屉：7 个入口 + 图标块，靠细线分组 -->
    <ScrollView
        android:layout_width="286dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/bnNavBg"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="38dp"
            android:paddingBottom="24dp">

            <!-- 品牌块：没有底色，只有字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:text="@string/app_name"
                android:textColor="?attr/bnTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:text="@string/nav_subtitle"
                android:textColor="?attr/bnTextSecondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="?attr/bnDivider" />

            <TextView
                style="@style/NavSection"
                android:text="@string/nav_section_new" />

            <LinearLayout
                android:id="@+id/navAddManual"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_plus" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_add_manual" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navQuick"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_quick" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_quick" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navCamera"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_camera" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_camera" />
            </LinearLayout>

            <TextView
                style="@style/NavSection"
                android:text="@string/nav_section_manage" />

            <LinearLayout
                android:id="@+id/navAllEvents"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_list" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_all_events" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navReconcile"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_check" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_reconcile" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_gear" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_settings" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="?attr/bnDivider" />

            <LinearLayout
                android:id="@+id/navHelp"
                style="@style/NavRow">
                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_help" />
                <TextView
                    style="@style/NavLabel"
                    android:text="@string/nav_help" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
