<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- ================= 输入渠道 ================= -->
        <LinearLayout
            android:id="@+id/headInput"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="输入渠道" />

            <ImageView
                android:id="@+id/arrowInput"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="截图识别" />

                <ImageButton
                    android:id="@+id/btnHelpShot"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="4dp"
                android:text="@string/label_api_key" />

            <EditText
                android:id="@+id/etApiKey"
                style="@style/FormInput"
                android:inputType="textPassword" />

            <TextView
                style="@style/FormLabel"
                android:text="@string/label_model" />

            <EditText
                android:id="@+id/etModel"
                style="@style/FormInput"
                android:inputType="text" />

            <CheckBox
                android:id="@+id/cbShotWatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/shot_watch_label" />

            <Button
                android:id="@+id/btnMediaPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_grant_media" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="其他入口" />

                <ImageButton
                    android:id="@+id/btnHelpEntry"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="6dp"
                android:text="侧边栏" />

            <Button
                android:id="@+id/btnSidebarEntry"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="@string/sidebar_entry_show" />

            <Button
                android:id="@+id/btnSidebarGuide"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_sidebar_guide" />

            <TextView
                style="@style/FormLabel"
                android:text="通知栏" />

            <Button
                android:id="@+id/btnTileGuide"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="@string/btn_tile_guide" />

            <Button
                android:id="@+id/btnNtfy"
                style="@style/BtnTonal"
                android:layout_marginTop="14dp"
                android:text="高级 · 第三方推送" />

            <TextView
                android:id="@+id/tvNtfySummary"
                style="@style/HintText"
                android:visibility="gone"
                android:text="已启用" />
        </LinearLayout>

        <!-- ================= 日历与同步 ================= -->
        <LinearLayout
            android:id="@+id/headCalendar"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="日历与同步" />

            <ImageView
                android:id="@+id/arrowCalendar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_marginTop="4dp"
                android:text="目标日历" />

            <Spinner
                android:id="@+id/spCalendar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                android:id="@+id/tvCalendarHint"
                style="@style/HintText" />

            <Button
                android:id="@+id/btnCreateCalendar"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_create_calendar" />

            <Button
                android:id="@+id/btnCalendarPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/perm_calendar" />

            <TextView
                style="@style/SectionSubLabel"
                android:text="@string/label_remind" />

            <EditText
                android:id="@+id/etRemind"
                style="@style/FormInput"
                android:inputType="text" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/title_reconcile" />

                <ImageButton
                    android:id="@+id/btnHelpReconcile"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbReconcile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_reconcile_enabled" />

            <TextView
                style="@style/FormLabel"
                android:text="@string/label_reconcile_interval" />

            <Spinner
                android:id="@+id/spReconcileInterval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <CheckBox
                android:id="@+id/cbReconcileNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_reconcile_notify" />

            <Button
                android:id="@+id/btnReconcileNow"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_reconcile_now" />

        </LinearLayout>

        <!-- ================= 备份 ================= -->
        <LinearLayout
            android:id="@+id/headBackup"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="备份" />

            <ImageButton
                android:id="@+id/btnHelpBackup"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />

            <ImageView
                android:id="@+id/arrowBackup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnExportIcs"
                style="@style/BtnTonal"
                android:layout_marginTop="6dp"
                android:text="@string/btn_export_ics" />

            <Button
                android:id="@+id/btnBackupLedger"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_backup_ledger" />
        </LinearLayout>

        <!-- ================= 外观 ================= -->
        <LinearLayout
            android:id="@+id/headAppearance"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="外观" />

            <ImageButton
                android:id="@+id/btnHelpTheme"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />

            <ImageView
                android:id="@+id/arrowAppearance"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="4dp"
                android:text="配色主题" />

            <Spinner
                android:id="@+id/spTheme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                style="@style/FormLabel"
                android:text="明暗" />

            <Spinner
                android:id="@+id/spThemeMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </LinearLayout>

        <!-- ================= 诊断与帮助 ================= -->
        <LinearLayout
            android:id="@+id/headDiagnostics"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="诊断与帮助" />

            <ImageView
                android:id="@+id/arrowDiagnostics"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnHealth"
                style="@style/BtnTonal"
                android:layout_marginTop="6dp"
                android:text="运行体检" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="系统权限" />

                <ImageButton
                    android:id="@+id/btnHelpA11y"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNotifAccess"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="@string/perm_notification" />

            <Button
                android:id="@+id/btnOpenA11y"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_open_a11y" />

            <Button
                android:id="@+id/btnCrashLog"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_crash_log" />

            <Button
                android:id="@+id/btnAppDetail"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/perm_app_detail" />

            <Button
                android:id="@+id/btnAbout"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/about_entry" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            style="@style/BtnPrimary"
            android:layout_marginTop="26dp"
            android:text="@string/btn_save_settings" />
    </LinearLayout>
</ScrollView>
