<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- 外观 -->
        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="8dp"
            android:text="外观" />

        <TextView
            style="@style/FormLabel"
            android:layout_marginTop="0dp"
            android:text="配色主题" />

        <Spinner
            android:id="@+id/spTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <TextView
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="@string/hint_theme" />

        <!-- ===== 目标日历 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="10dp"
            android:text="日历" />

        <Spinner
            android:id="@+id/spCalendar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <TextView
            android:id="@+id/tvCalendarHint"
            style="@style/HintText"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnCreateCalendar"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_create_calendar" />

        <!-- ===== 提醒 ===== -->
        <TextView
            style="@style/FormLabel"
            android:text="@string/label_remind" />

        <EditText
            android:id="@+id/etRemind"
            style="@style/FormInput"
            android:hint="1440,60"
            android:inputType="text" />

        <!-- ===== 一句话 / 侧边栏 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="ntfy 补查" />

        <TextView
            style="@style/FormLabel"
            android:layout_marginTop="0dp"
            android:text="@string/label_ntfy_topic" />

        <EditText
            android:id="@+id/etNtfyTopic"
            style="@style/FormInput"
            android:hint="todo-xxxxxxxxxxxx"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvNtfyHint"
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="@string/hint_ntfy_topic" />

        <Button
            android:id="@+id/btnCatchUpNow"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_catch_up_now" />

        <Button
            android:id="@+id/btnSendTest"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_send_test" />

        <!-- ===== 识别模型 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="截图识别" />

        <TextView
            style="@style/FormLabel"
            android:layout_marginTop="0dp"
            android:text="@string/label_api_key" />

        <EditText
            android:id="@+id/etApiKey"
            style="@style/FormInput"
            android:hint="sk-..."
            android:inputType="textPassword" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_model" />

        <EditText
            android:id="@+id/etModel"
            style="@style/FormInput"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvModelHint"
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="@string/model_hint" />

        <CheckBox
            android:id="@+id/cbShotWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/shot_watch_label" />

        <TextView
            android:id="@+id/tvShotWatchHint"
            style="@style/HintText"
            android:text="@string/shot_watch_hint" />

        <Button
            android:id="@+id/btnMediaPerm"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_grant_media" />

        <!-- ===== 推送行为 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="推送行为" />

        <CheckBox
            android:id="@+id/cbAutoImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_auto_import" />

        <CheckBox
            android:id="@+id/cbStrictParse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_strict_parse" />

        <TextView
            android:id="@+id/tvStrictHint"
            style="@style/HintText"
            android:text="@string/hint_strict_parse" />

        <!-- ===== 对账 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/title_reconcile" />

        <CheckBox
            android:id="@+id/cbReconcile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_reconcile_enabled" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_reconcile_interval" />

        <Spinner
            android:id="@+id/spReconcileInterval"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <CheckBox
            android:id="@+id/cbReconcileNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_reconcile_notify" />

        <Button
            android:id="@+id/btnReconcileNow"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_reconcile_now" />

        <!-- ===== 备份 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="备份" />

        <Button
            android:id="@+id/btnExportIcs"
            style="@style/BtnTonal"
            android:text="@string/btn_export_ics" />

        <Button
            android:id="@+id/btnBackupLedger"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_backup_ledger" />

        <!-- ===== 被忽略的推送 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/label_ignored" />

        <TextView
            android:id="@+id/tvIgnored"
            style="@style/HintText"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="@string/hint_ignored_empty" />

        <Button
            android:id="@+id/btnClearIgnored"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_clear_ignored" />

        <Button
            android:id="@+id/btnCrashLog"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_crash_log" />

        <!-- ===== 保存 ===== -->
        <Button
            android:id="@+id/btnSaveSettings"
            style="@style/BtnPrimary"
            android:layout_marginTop="26dp"
            android:text="@string/btn_save_settings" />

        <!-- ===== 关于 ===== -->
        <TextView
            style="@style/SectionLabel"
            android:text="关于" />

        <Button
            android:id="@+id/btnAbout"
            style="@style/BtnTonal"
            android:text="@string/about_entry" />

        <!-- ===== 权限与后台 ===== -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/title_permission" />

        <Button
            android:id="@+id/btnNotifAccess"
            style="@style/BtnTonal"
            android:text="@string/perm_notification" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/a11y_title" />

        <TextView
            android:id="@+id/tvA11yHint"
            style="@style/HintText"
            android:text="@string/a11y_hint" />

        <Button
            android:id="@+id/btnOpenA11y"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_open_a11y" />

        <Button
            android:id="@+id/btnSidebarGuide"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_sidebar_guide" />

        <Button
            android:id="@+id/btnTileGuide"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_tile_guide" />

        <Button
            android:id="@+id/btnCalendarPerm"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/perm_calendar" />

        <Button
            android:id="@+id/btnAutostart"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/perm_autostart" />

        <Button
            android:id="@+id/btnBattery"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/perm_battery" />

        <Button
            android:id="@+id/btnAppDetail"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/perm_app_detail" />
    </LinearLayout>
</ScrollView>
