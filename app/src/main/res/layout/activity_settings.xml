<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- ================= 输入渠道 ================= -->
        <LinearLayout
            android:id="@+id/headInput"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="输入渠道" />

            <ImageView
                android:id="@+id/arrowInput"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="截图识别" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="8dp"
                android:text="识别方式" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="看图识字一直开着（本地 OCR，不联网）。两张卡决定要不要再加模型，点卡片进设置。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardCloud"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCardCloudTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="云端模型"
                            android:textColor="?attr/bnTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/cardCloudCheck"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_check"
                            android:tint="?attr/bnPrimary"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCardCloudState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="未启用"
                        android:textColor="?attr/bnTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/cardLocal"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCardLocalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="本地模型"
                            android:textColor="?attr/bnTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/cardLocalCheck"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_check"
                            android:tint="?attr/bnPrimary"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCardLocalState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="未启用"
                        android:textColor="?attr/bnTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/HintText"
                android:layout_marginTop="8dp"
                android:text="两张都亮时先试云端模型，不行再试本地模型，最后退到看图识字；两张都不亮就只用看图识字。" />

            <CheckBox
                android:id="@+id/cbShotWatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/shot_watch_label" />

            <Button
                android:id="@+id/btnMediaPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_grant_media" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="其他入口" />

                <ImageButton
                    android:id="@+id/btnHelpEntry"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="6dp"
                android:text="侧边栏" />

            <Button
                android:id="@+id/btnSidebarEntry"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="@string/sidebar_entry_show" />

            <Button
                android:id="@+id/btnSidebarGuide"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_sidebar_guide" />

            <TextView
                style="@style/FormLabel"
                android:text="通知栏" />

            <Button
                android:id="@+id/btnTileGuide"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="@string/btn_tile_guide" />

            <TextView
                style="@style/FormLabel"
                android:text="高级" />

            <Button
                android:id="@+id/btnNtfy"
                style="@style/BtnTonal"
                android:layout_marginTop="4dp"
                android:text="第三方通道" />

            <TextView
                android:id="@+id/tvNtfySummary"
                style="@style/HintText"
                android:visibility="gone"
                android:text="已启用" />
        </LinearLayout>

        <!-- ================= 日历与同步 ================= -->
        <LinearLayout
            android:id="@+id/headCalendar"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="日历与同步" />

            <ImageView
                android:id="@+id/arrowCalendar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_marginTop="4dp"
                android:text="目标日历" />

            <Spinner
                android:id="@+id/spCalendar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                android:id="@+id/tvCalendarHint"
                style="@style/HintText" />

            <Button
                android:id="@+id/btnCreateCalendar"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_create_calendar" />

            <Button
                android:id="@+id/btnCalendarPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/perm_calendar" />

            <TextView
                style="@style/SectionSubLabel"
                android:text="@string/label_remind" />

            <EditText
                android:id="@+id/etRemind"
                style="@style/FormInput"
                android:inputType="text" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/title_reconcile" />

                <ImageButton
                    android:id="@+id/btnHelpReconcile"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbReconcile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_reconcile_enabled" />

            <TextView
                style="@style/FormLabel"
                android:text="@string/label_reconcile_interval" />

            <Spinner
                android:id="@+id/spReconcileInterval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <CheckBox
                android:id="@+id/cbReconcileNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_reconcile_notify" />

            <Button
                android:id="@+id/btnReconcileNow"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_reconcile_now" />

        </LinearLayout>

        <!-- ================= 备份 ================= -->
        <LinearLayout
            android:id="@+id/headBackup"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="备份" />

            <ImageButton
                android:id="@+id/btnHelpBackup"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />

            <ImageView
                android:id="@+id/arrowBackup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnExportIcs"
                style="@style/BtnTonal"
                android:layout_marginTop="6dp"
                android:text="@string/btn_export_ics" />

            <Button
                android:id="@+id/btnBackupLedger"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_backup_ledger" />

            <Button
                android:id="@+id/btnGenerateConfigCode"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="生成配置码" />

            <Button
                android:id="@+id/btnImportConfigCode"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="导入配置码" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="8dp"
                android:text="配置码只带配色主题和 ntfy 主题，方便把手机借给家人朋友用；不含 API Key，也不含待办。" />
        </LinearLayout>

        <!-- ================= 外观 ================= -->
        <LinearLayout
            android:id="@+id/headAppearance"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="外观" />

            <ImageView
                android:id="@+id/arrowAppearance"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="4dp"
                android:text="配色主题" />

            <Spinner
                android:id="@+id/spTheme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                style="@style/FormLabel"
                android:text="明暗" />

            <Spinner
                android:id="@+id/spThemeMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                style="@style/FormLabel"
                android:text="已结束的待办" />

            <Spinner
                android:id="@+id/spEndedStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                style="@style/HintText"
                android:text="整卡读满后淡出：进度铺满整张卡，结束后整张卡隐去；只淡文字：卡片保持原样，标题和时间变浅。" />
        </LinearLayout>

        <!-- ================= 诊断与帮助 ================= -->
        <LinearLayout
            android:id="@+id/headDiagnostics"
            style="@style/SettingsGroupHead">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="诊断与帮助" />

            <ImageView
                android:id="@+id/arrowDiagnostics"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="展开或收起"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/bnTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnFeedback"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/feedback_entry" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="6dp"
                android:text="@string/feedback_entry_hint" />

            <Button
                android:id="@+id/btnPrivacy"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="隐私政策" />

            <Button
                android:id="@+id/btnOnboarding"
                style="@style/BtnTonal"
                android:layout_marginTop="6dp"
                android:text="新手引导" />

            <Button
                android:id="@+id/btnHealth"
                style="@style/BtnTonal"
                android:layout_marginTop="6dp"
                android:text="运行体检" />

            <LinearLayout
                style="@style/SettingsSubHead">

                <TextView
                    style="@style/SectionSubLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="系统权限" />

                <ImageButton
                    android:id="@+id/btnHelpA11y"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenA11y"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_open_a11y" />

            <Button
                android:id="@+id/btnNotifPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_notif_perm" />

            <Button
                android:id="@+id/btnBatteryPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="电池白名单" />

            <Button
                android:id="@+id/btnAutostartPerm"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="自启动" />

            <Button
                android:id="@+id/btnCrashLog"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/btn_crash_log" />

            <Button
                android:id="@+id/btnAppDetail"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/perm_app_detail" />

            <Button
                android:id="@+id/btnAbout"
                style="@style/BtnTonal"
                android:layout_marginTop="10dp"
                android:text="@string/about_entry" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            style="@style/BtnPrimary"
            android:layout_marginTop="26dp"
            android:text="@string/btn_save_settings" />
    </LinearLayout>
</ScrollView>
