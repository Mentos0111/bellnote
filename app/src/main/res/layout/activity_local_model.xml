<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用本地模型"
                    android:textColor="?attr/bnTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="在手机上跑 Gemma 3 1B，要先把模型下下来"
                    android:textColor="?attr/bnTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocalState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/bnTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPickModel"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="切换模型" />

        <Button
            android:id="@+id/btnLocalAction"
            style="@style/BtnTonal"
            android:layout_marginTop="12dp"
            android:text="下载模型（657 MB）" />

        <Button
            android:id="@+id/btnLocalDelete"
            style="@style/BtnDanger"
            android:layout_marginTop="8dp"
            android:text="删除模型" />

        <TextView
            style="@style/HintText"
            android:layout_marginTop="14dp"
            android:text="模型只在这台手机上跑，不会把截图或文字发出去；没装好或没认出结果时，自动退回本地规则。" />
    </LinearLayout>
</ScrollView>
