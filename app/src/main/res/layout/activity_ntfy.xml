<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="总开关" />

            <ImageButton
                android:id="@+id/btnHelpMode"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swNtfyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:text="@string/ntfy_mode_switch"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNtfyStatus"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="还没配置" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="消息从哪来" />

            <ImageButton
                android:id="@+id/btnHelpChannel"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spNtfyChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/groupServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldCaption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/ntfy_server_label" />

                <ImageButton
                    android:id="@+id/btnHelpServer"
                    style="@style/SettingsHelpButton"
                    android:contentDescription="看说明"
                    android:src="@drawable/ic_nav_help" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNtfyServer"
                style="@style/FormInput"
                android:hint="https://ntfy.sh"
                android:inputType="textUri" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FormLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/label_push_topic" />

            <ImageButton
                android:id="@+id/btnHelpTopic"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNtfyTopic"
            style="@style/FormInput"
            android:hint="todo-xxxx"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCatchUpNow"
                style="@style/BtnTonal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/btn_catch_up_now" />

            <ImageButton
                android:id="@+id/btnHelpCatchUp"
                style="@style/SettingsHelpButton"
                android:layout_marginStart="8dp"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSendTest"
                style="@style/BtnTonal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/btn_send_test" />

            <ImageButton
                android:id="@+id/btnHelpTest"
                style="@style/SettingsHelpButton"
                android:layout_marginStart="8dp"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="消息记录" />

            <ImageButton
                android:id="@+id/btnHelpLog"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMessageLog"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/ntfy_log_entry" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="推送怎么处理" />

            <ImageButton
                android:id="@+id/btnHelpRules"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAutoImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_auto_import" />

        <CheckBox
            android:id="@+id/cbStrictParse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_strict_parse" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="其他 App 的通知" />

            <ImageButton
                android:id="@+id/btnHelpOther"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveNtfy"
            style="@style/BtnPrimary"
            android:layout_marginTop="24dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
