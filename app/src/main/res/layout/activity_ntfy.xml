<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/SectionSubLabel"
            android:layout_marginTop="0dp"
            android:text="总开关" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swNtfyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:text="@string/ntfy_mode_switch"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/HintText"
            android:text="@string/ntfy_mode_hint" />

        <TextView
            android:id="@+id/tvNtfyStatus"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="还没配置" />

        <Button
            android:id="@+id/btnWhatIsNtfy"
            style="@style/BtnTonal"
            android:layout_marginTop="12dp"
            android:text="什么是 ntfy，为什么要填主题" />

        <TextView
            style="@style/SectionSubLabel"
            android:text="消息从哪来" />

        <Spinner
            android:id="@+id/spNtfyChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvServerLabel"
            style="@style/FieldCaption"
            android:layout_marginTop="10dp"
            android:text="@string/ntfy_server_label" />

        <EditText
            android:id="@+id/etNtfyServer"
            style="@style/FormInput"
            android:hint="https://ntfy.sh"
            android:inputType="textUri"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvServerHint"
            style="@style/HintText"
            android:text="@string/ntfy_server_hint"
            android:visibility="gone" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_push_topic" />

        <EditText
            android:id="@+id/etNtfyTopic"
            style="@style/FormInput"
            android:hint="todo-xxxx"
            android:inputType="text" />

        <TextView
            style="@style/HintText"
            android:text="@string/hint_push_topic" />

        <Button
            android:id="@+id/btnCatchUpNow"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_catch_up_now" />

        <Button
            android:id="@+id/btnSendTest"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/btn_send_test" />

        <TextView
            style="@style/HintText"
            android:text="测试推送会在 10 分钟后发出，用来确认整条链路通不通；发完也会记进下面的消息记录。" />

        <TextView
            style="@style/SectionSubLabel"
            android:text="消息记录" />

        <Button
            android:id="@+id/btnMessageLog"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/ntfy_log_entry" />

        <TextView
            style="@style/HintText"
            android:text="@string/ntfy_log_hint" />

        <TextView
            style="@style/SectionSubLabel"
            android:text="推送怎么处理" />

        <CheckBox
            android:id="@+id/cbAutoImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_auto_import" />

        <CheckBox
            android:id="@+id/cbStrictParse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_strict_parse" />

        <TextView
            android:id="@+id/tvStrictHint"
            style="@style/HintText"
            android:text="@string/hint_strict_parse" />

        <TextView
            style="@style/SectionSubLabel"
            android:text="@string/ntfy_local_title" />

        <TextView
            style="@style/HintText"
            android:text="@string/ntfy_local_hint" />

        <Button
            android:id="@+id/btnLocalNtfy"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/ntfy_local_learn" />

        <TextView
            style="@style/SectionSubLabel"
            android:text="其他 App 的通知" />

        <TextView
            style="@style/HintText"
            android:text="@string/hint_other_sources" />

        <Button
            android:id="@+id/btnSaveNtfy"
            style="@style/BtnPrimary"
            android:layout_marginTop="24dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
