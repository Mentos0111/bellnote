<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- ================= ① 连接 ================= -->

        <TextView
            style="@style/SectionSubLabel"
            android:layout_marginTop="0dp"
            android:text="@string/ntfy_group_connect" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swNtfyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="@string/ntfy_mode_switch"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/HintText"
            android:text="@string/cap_mode" />

        <TextView
            android:id="@+id/tvNtfyStatus"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="还没配置" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldCaption"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="消息从哪来" />

            <ImageButton
                android:id="@+id/btnHelpChannel"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spNtfyChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/groupServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldCaption"
                android:layout_marginTop="10dp"
                android:text="@string/ntfy_server_label" />

            <EditText
                android:id="@+id/etNtfyServer"
                style="@style/FormInput"
                android:hint="https://ntfy.sh"
                android:inputType="textUri" />

            <TextView
                style="@style/HintText"
                android:text="@string/cap_server" />
        </LinearLayout>

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_push_topic" />

        <EditText
            android:id="@+id/etNtfyTopic"
            style="@style/FormInput"
            android:hint="todo-xxxx"
            android:inputType="text" />

        <TextView
            style="@style/HintText"
            android:text="@string/cap_topic" />

        <!-- ================= ② 后台接收 ================= -->

        <TextView
            style="@style/SectionSubLabel"
            android:layout_marginTop="22dp"
            android:text="@string/ntfy_group_background" />

        <TextView
            style="@style/FieldCaption"
            android:layout_marginTop="6dp"
            android:text="@string/ntfy_bg_title" />

        <RadioGroup
            android:id="@+id/rgBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbBgOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/ntfy_bg_off"
                android:textColor="?attr/bnTextPrimary" />

            <RadioButton
                android:id="@+id/rbBgAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/ntfy_bg_alarm"
                android:textColor="?attr/bnTextPrimary" />

            <RadioButton
                android:id="@+id/rbBgService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/ntfy_bg_service"
                android:textColor="?attr/bnTextPrimary" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvBgHint"
            style="@style/HintText"
            android:text="@string/ntfy_bg_hint_alarm" />

        <TextView
            android:id="@+id/tvBgStatus"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="" />

        <Button
            android:id="@+id/btnBgNotifyPerm"
            style="@style/BtnTonal"
            android:layout_marginTop="10dp"
            android:text="@string/ntfy_bg_perm_notify" />

        <Button
            android:id="@+id/btnBgExactAlarm"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/ntfy_bg_perm_exact" />

        <Button
            android:id="@+id/btnBgBattery"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/ntfy_bg_perm_battery" />

        <!-- ================= ③ 收到后怎么处理 ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionSubLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/ntfy_group_receive" />

            <ImageButton
                android:id="@+id/btnHelpRules"
                style="@style/SettingsHelpButton"
                android:contentDescription="看说明"
                android:src="@drawable/ic_nav_help" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAutoImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_auto_import" />

        <CheckBox
            android:id="@+id/cbStrictParse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_strict_parse" />

        <Button
            android:id="@+id/btnCatchUpNow"
            style="@style/BtnTonal"
            android:layout_marginTop="12dp"
            android:text="@string/btn_catch_up_now" />

        <Button
            android:id="@+id/btnSendTest"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/btn_send_test" />

        <TextView
            style="@style/HintText"
            android:text="@string/cap_actions" />

        <!-- ================= ④ 诊断 ================= -->

        <TextView
            style="@style/SectionSubLabel"
            android:layout_marginTop="22dp"
            android:text="@string/ntfy_group_diag" />

        <Button
            android:id="@+id/btnMessageLog"
            style="@style/BtnTonal"
            android:layout_marginTop="8dp"
            android:text="@string/ntfy_log_entry" />

        <TextView
            style="@style/HintText"
            android:text="@string/cap_log" />

        <TextView
            style="@style/SectionSubLabel"
            android:layout_marginTop="18dp"
            android:text="其他 App 的通知" />

        <TextView
            style="@style/HintText"
            android:text="@string/cap_other" />

        <Button
            android:id="@+id/btnSaveNtfy"
            style="@style/BtnPrimary"
            android:layout_marginTop="24dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
