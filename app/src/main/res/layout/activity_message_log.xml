<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bnWindowBg"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLogCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/bnTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearLog"
            style="@style/BtnTonal"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="96dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/ntfy_log_clear"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        style="@style/HintText"
        android:layout_marginTop="4dp"
        android:text="@string/ntfy_log_hint" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvLogEmpty"
            style="@style/HintText"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/ntfy_log_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
