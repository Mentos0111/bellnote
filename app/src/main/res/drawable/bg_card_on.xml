<?xml version="1.0" encoding="utf-8"?>
<!-- 启用状态的识别卡片：普通卡底 + 一层很淡的主题色，整块看起来是「亮着的」 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/bnCard" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/bnCardEdge" />
        </shape>
    </item>
    <item android:alpha="0.16">
        <shape android:shape="rectangle">
            <solid android:color="?attr/bnPrimary" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
