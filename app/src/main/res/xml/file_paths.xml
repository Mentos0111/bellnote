<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 截屏识别：内部把截图交给识别页，或从识别页分享出去 -->
    <cache-path name="captures" path="captures/" />
    <cache-path name="images" path="images/" />
    <!-- 拍照存这里，再把 content:// 交给识别页 -->
    <cache-path name="photos" path="photos/" />
    <!-- 反馈包：zip 交给系统分享面板时要用 content:// -->
    <cache-path name="feedback" path="feedback/" />
</paths>
